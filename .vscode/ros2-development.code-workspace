{
	"folders": [
		{
			"path": ".."
		}
	],
	"settings": {
		"task.allowAutomaticTasks": "on"
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "C++ debug",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder}/main",
				"args": [],
				"stopAtEntry": false,
				"cwd": "${workspaceFolder}",
				"environment": [],
				"externalConsole": false,
				"MIMode": "gdb",
				"setupCommands": [
					{
						"description": "Enable pretty-printing for gdb",
						"text": "-enable-pretty-printing",
						"ignoreFailures": true
					}
				]
			},
			{
				"name": "C++ compilar y debuggear",
				"type": "cppdbg",
				"request": "launch",
				"preLaunchTask": "compilar",
				"program": "${workspaceFolder}/main",
				"args": [],
				"stopAtEntry": false,
				"cwd": "${workspaceFolder}",
				"environment": [],
				"externalConsole": false,
				"MIMode": "gdb",
				"setupCommands": [
					{
						"description": "Enable pretty-printing for gdb",
						"text": "-enable-pretty-printing",
						"ignoreFailures": true
					}
				]
			},
			{
				"name": "Go debug",
				"type": "go",
				"request": "launch",
				"mode": "debug",
				"program": "${fileDirname}/${fileBasename}",
				"args": [],
				"env": {},
				"console": "integratedTerminal"
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "🔐 xhost local root (auto)",
				"type": "shell",
				"detail": "Es para activar la visualización gráfica de programas dentro del contenedor",
				"command": "echo \"xhost auto task\"",
				"linux": {
					"command": "bash -lc 'command -v xhost >/dev/null 2>&1 && xhost +local:root || true'"
				},
				"runOptions": {
					"runOn": "folderOpen"
				},
				"problemMatcher": []
			},
			{
				"label": "🧑‍🤝‍🧑 VCS clone",
				"detail": "Clona repos en src usando vcs + .repos",
				"type": "shell",
				"command": "${workspaceFolder}/tools/vcs-clone.sh",
				"problemMatcher": []
			},
			{
				"label": "⏬ VCS pull",
				"detail": "Actualiza workspace haciendo pull",
				"type": "shell",
				"command": "${workspaceFolder}/tools/vcs-pull.sh",
				"problemMatcher": []
			},
			{
				"label": "📋 VCS Status",
				"detail": "Muestra el estado del workspace y de todos los repos en src",
				"type": "shell",
				"command": "${workspaceFolder}/tools/vcs-status.sh",
				"problemMatcher": []
			},
			{
				"label": "⏫ VCS Push",
				"detail": "Hace push del workspace y de los repos en src",
				"type": "shell",
				"command": "${workspaceFolder}/tools/vcs-push.sh",
				"problemMatcher": []
			},
			{
				"label": "🔧 DOCKER RECOMPILAR",
				"type": "shell",
				"command": "docker compose build ros2-german",
				"problemMatcher": []
			},
			{
				"label": "🖼️ VER FRAMES",
				"type": "shell",
				"command": "./tools/exec.sh 'cd log && ros2 run tf2_tools view_frames'",
				"problemMatcher": []
			},
			{
				"label": "🐳 EJECUTAR COMANDO",
				"type": "shell",
				"command": "docker exec -ti ros2-german bash",
				"problemMatcher": []
			},
			{
				"label": "🚀 DOCKER UP",
				"type": "shell",
				"command": "docker compose up -d",
				"problemMatcher": []
			},
			{
				"label": "❌ DOCKER DOWN",
				"type": "shell",
				"command": "docker compose down",
				"problemMatcher": []
			},
			{
				"label": "⚙️ COMPILAR ROS",
				"type": "shell",
				"command": "./tools/compile-ros.sh",
				"problemMatcher": []
			},
			{
				"label": "🖥️ LANZAR SIMULACION",
				"type": "shell",
				"command": "./tools/exec.sh ros2 launch navegacion_gps simulacion.launch.py ekf_global:=True ukf:=True fromll_output_frame:=odom | tee log/simulacion_$(date +%Y-%m-%d_%H-%M).log",
				"problemMatcher": []
			},
			{
				"label": "📌 LANZAR NAVEGACION (real.launch.py)",
				"type": "shell",
				// "command": "./tools/exec.sh ros2 launch navegacion_gps real.launch.py ekf_local:=False zones_manager:=False enable_rtk:=True ukf:=True",
				// "command": "./tools/exec.sh ros2 launch navegacion_gps real.launch.py ekf_local:=False ekf_global:=True zones_manager:=False datum_setter:=True ukf:=True enable_gps_course_heading:=True gps_course_heading_enable_consistency_filters:=True gps_course_heading_enable_offset_compensation:=True",
				// "command": "./tools/exec.sh ros2 launch navegacion_gps real.launch.py ekf_global:=True zones_manager:=False datum_setter:=True ukf:=False enable_gps_course_heading:=True gps_course_heading_enable_consistency_filters:=True gps_course_heading_enable_offset_compensation:=True",
				// "command": "./tools/exec.sh ros2 launch navegacion_gps real.launch.py ekf_global:=True zones_manager:=False datum_setter:=True ukf:=True enable_gps_course_heading:=True gps_course_heading_enable_consistency_filters:=True gps_course_heading_enable_offset_compensation:=True use_robot_state_publisher:=True",
/* PROBAR 1	*/	"command": "./tools/exec.sh ros2 launch navegacion_gps real.launch.py datum_setter:=True zones_manager:=False use_robot_state_publisher:=True | tee log/patrullaje_$(date +%Y-%m-%d_%H-%M).log",
/* PROBAR 2	*/	// "command": "./tools/exec.sh ros2 launch navegacion_gps real.launch.py datum_setter:=True zones_manager:=False use_robot_state_publisher:=True enable_rtk:=true enable_rtk_source_manager:=true",
				"problemMatcher": []
			},
			{
				"label": "⚙️ LANZAR CONTROLADOR (launch_controller.sh)",
				"type": "shell",
				// "command": "./tools/launch_controller.sh",
				// "command": "./tools/exec.sh ros2 launch controller_server controller_server_sim.launch.py",
				"command": "./tools/exec.sh ros2 launch map_tools bootup.launch.py use_sim:=true",
				// "command": "./tools/exec.sh ros2 launch map_tools bootup.launch.py use_sim:=false",
				"problemMatcher": []
			},
			{
				"label": "📐 RVIZ",
				"type": "shell",
				"command": "./tools/launch_real_rviz.sh",
				"problemMatcher": []
			},
			{
				"label": "⌨️ TELEOP TWIST KEYBOARD",
				"type": "shell",
				"command": "./tools/exec.sh ros2 run teleop_twist_keyboard teleop_twist_keyboard --ros-args -r cmd_vel:=/cmd_vel_safe",
				"problemMatcher": []
			}
		],
		"inputs": [
			{
				"id": "serviceName",
				"description": "Nombre del servicio de Docker",
				"default": "users-api",
				"type": "promptString"
			},
			{
				"id": "command",
				"description": "Comando a ejecutar",
				"default": "bash",
				"type": "promptString"
			}
		]
	}
}
